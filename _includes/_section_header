<div class="row">
  <div class="col-lg-12 text-center">
    {% if include.title and include.title != "" %}
      <h2 class="section-heading text-uppercase">{{ include.title }}</h2>
    {% endif %}
    {% if include.subtitle and include.subtitle != "" %}
      <h3 class="section-subheading text-muted">{{ include.subtitle }}</h3>
    {% endif %}
  </div>
</div>